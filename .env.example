# Copy to .env and fill in. Never commit .env.

USER_NAME=Ahmad
TIMEZONE=Asia/Karachi

# Public URL of this service: the Alternate Clouds URL, or your local tunnel while developing
PUBLIC_BASE_URL=http://localhost:8000
# Any long random string; appended to the Vapi webhook URL as ?token=
WEBHOOK_TOKEN=

# Anthropic
ANTHROPIC_API_KEY=
MODEL_CONCIERGE=claude-sonnet-5-5
MODEL_FAST=claude-haiku-5-5

# Vapi (Dashboard > API keys; Phone Numbers > imported Twilio number > ID)
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_MODEL_PROVIDER=anthropic
VAPI_MODEL=claude-haiku-5-5
VAPI_TOOL_TIMEOUT_SECONDS=25
# Public key (Dashboard > API keys > Public): needed to end a call through the live control URL
VAPI_PUBLIC_API_KEY=
END_CALL_GRACE_SECONDS=10
CARD_DEADLINE_SECONDS=22

# 1 = no real phone call; run scripts/simulate_call.py to play the front desk
SIMULATE_CALLS=1
# The seeded demo business rings this number (Daniyal's phone, E.164, e.g. +923001234567)
DEMO_FRONT_DESK_NUMBER=

# Google Places API (New); leave empty to use data/seed_places.json
GOOGLE_PLACES_API_KEY=

# Cal.com API v2 (web channel)
CALCOM_BASE_URL=https://api.cal.com/v2
CALCOM_API_KEY=
CALCOM_USERNAME=
CALCOM_EVENT_SLUG=
CALCOM_ATTENDEE_EMAIL=
